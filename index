                <th class="p-1.5 text-center">Sep</th>
                <th class="p-1.5 text-center">Okt</th>
                <th class="p-1.5 text-center">Nov</th>
                <th class="p-1.5 text-center">Des</th>
                <th class="p-2 text-right">Grand Total</th>
              </tr>
            </thead>
            <tbody>${rowsHtml}</tbody>
          </table>
        `;
      }
    }

    // --- 10. EXPORT EXCEL & PDF ---
    function eksporExcel() {
      const table = document.getElementById('tabelExportLaporan');
      if (!table) return;

      const wb = XLSX.utils.book_new();
      const ws = XLSX.utils.table_to_sheet(table);

      const t = document.getElementById('lapTahun').value;
      const b = document.getElementById('lapBulan').value;
      const m = document.getElementById('lapMinggu').value;

      let sheetName = `Jimpitan_${currentLaporanMode}`;
      XLSX.utils.book_append_sheet(wb, ws, sheetName);
      XLSX.writeFile(wb, `SI-JIMPITAN27_${currentLaporanMode}_${t}_B${b}_M${m}.xlsx`);
    }

    function eksporPDF() {
      const { jsPDF } = window.jspdf;
      const doc = new jsPDF('p', 'pt', 'a4');

      const t = document.getElementById('lapTahun').value;
      const b = document.getElementById('lapBulan').value;
      const m = document.getElementById('lapMinggu').value;

      // Header KOP RT 27
      doc.setFont('helvetica', 'bold');
      doc.setFontSize(14);
      doc.setTextColor(5, 150, 105);
      doc.text('RUKUN TETANGGA 27 RUKUN WARGA 08', 297, 40, { align: 'center' });
      doc.setFontSize(11);
      doc.setTextColor(30, 41, 59);
      doc.text('PERUMAHAN GRIYA KEBONAGUNG, SUKODONO, SIDOARJO', 297, 56, { align: 'center' });
      doc.setFont('helvetica', 'normal');
      doc.setFontSize(9);
      doc.setTextColor(100, 116, 139);
      doc.text('Laporan Pertanggungjawaban Pembukuan Jimpitan Mingguan Warga', 297, 70, { align: 'center' });

      doc.setDrawColor(5, 150, 105);
      doc.setLineWidth(1.5);
      doc.line(40, 80, 555, 80);

      let judulLaporan = '';
      if (currentLaporanMode === 'mingguan') {
        judulLaporan = `Laporan Penarikan: Minggu Ke-${m}, Bulan ${namaBulan(b)} Tahun ${t}`;
      } else if (currentLaporanMode === 'bulanan') {
        judulLaporan = `Rekapitulasi Penarikan Bulanan: ${namaBulan(b)} Tahun ${t}`;
      } else {
        judulLaporan = `Matriks Rekapitulasi Kas Jimpitan Tahunan - Tahun ${t}`;
      }

      doc.setFont('helvetica', 'bold');
      doc.setFontSize(10);
      doc.setTextColor(15, 23, 42);
      doc.text(judulLaporan, 40, 98);

      // Render AutoTable
      doc.autoTable({
        html: '#tabelExportLaporan',
        startY: 110,
        theme: 'grid',
        headStyles: { fillColor: [5, 150, 105], textColor: 255, fontStyle: 'bold', fontSize: 8 },
        styles: { fontSize: 8, cellPadding: 4 },
        footStyles: { fillColor: [241, 245, 249], textColor: [15, 23, 42], fontStyle: 'bold' }
      });

      const finalY = doc.lastAutoTable.finalY || 400;

      // Bagian Tanda Tangan
      if (finalY < 700) {
        doc.setFont('helvetica', 'normal');
        doc.setFontSize(9);
        doc.setTextColor(15, 23, 42);

        const tglCetak = `Sukodono, ${new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}`;
        doc.text(tglCetak, 400, finalY + 30);
        doc.text('Mengetahui,', 80, finalY + 45);
        doc.text('Ketua RT 27 RW 08', 80, finalY + 58);
        doc.text('Bendahara / Petugas Jimpitan', 400, finalY + 58);

        doc.setFont('helvetica', 'bold');
        doc.text('( .................................... )', 80, finalY + 110);
        doc.text(`( ${appSettings.namaPetugas.split('(')[0].trim()} )`, 400, finalY + 110);
      }

      doc.save(`Laporan_SIJIMPITAN27_${currentLaporanMode}_${t}.pdf`);
    }

    // --- 11. PENGATURAN & BACKUP/RESTORE ---
    function simpanPengaturan() {
      const nominal = parseInt(document.getElementById('settingDefaultNominal').value);
      const nama = document.getElementById('settingNamaPetugas').value.trim();

      if (nominal < 500) {
        Swal.fire('Error', 'Nominal minimal Rp 500', 'error');
        return;
      }

      appSettings.defaultNominal = nominal;
      appSettings.namaPetugas = nama;
      saveAll();
      renderPenarikan();
      Swal.fire('Disimpan', 'Pengaturan berhasil diperbarui', 'success');
    }

    function backupDatabase() {
      const dataBackup = {
        warga: wargaList,
        transaksi: transaksiList,
        pengeluaran: pengeluaranList,
        settings: appSettings,
        exportAt: new Date().toISOString()
      };

      const blob = new Blob([JSON.stringify(dataBackup, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `BACKUP_SI_JIMPITAN27_${new Date().toISOString().split('T')[0]}.json`;
      a.click();
      URL.revokeObjectURL(url);
    }

    function restoreDatabase(event) {
      const file = event.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(e) {
        try {
          const imported = JSON.parse(e.target.result);
          if (imported.warga && imported.transaksi) {
            wargaList = imported.warga;
            transaksiList = imported.transaksi;
            pengeluaranList = imported.pengeluaran || [];
            if (imported.settings) appSettings = imported.settings;

            saveAll();
            renderPenarikan();
            renderWargaTable();
            renderPengeluaranTable();
            renderLaporan();
            renderDashboardCharts();

            Swal.fire('Berhasil', 'Database berhasil dipulihkan dari file JSON', 'success');
          } else {
            Swal.fire('Gagal', 'Format file JSON tidak sesuai!', 'error');
          }
        } catch (err) {
          Swal.fire('Error', 'Gagal membaca file JSON: ' + err.message, 'error');
        }
      };
      reader.readAsText(file);
    }

    // --- 12. CHART.JS VISUALISASI ---
    function renderDashboardCharts() {
      // 1. Chart 4 Pekan Terakhir
      const ctxMingguan = document.getElementById('chartMingguan')?.getContext('2d');
      if (ctxMingguan) {
        if (chartMingguanInstance) chartMingguanInstance.destroy();

        const labelsMinggu = ['Mgg 1 Okt', 'Mgg 2 Okt', 'Mgg 3 Okt', 'Mgg 4 Okt'];
        const valuesMinggu = [1, 2, 3, 4].map(mg => {
          return transaksiList
            .filter(x => x.tahun === 2026 && x.bulan === 10 && x.minggu === mg)
            .reduce((acc, c) => acc + Number(c.nominal), 0);
        });

        chartMingguanInstance = new Chart(ctxMingguan, {
          type: 'bar',
          data: {
            labels: labelsMinggu,
            datasets: [{
              label: 'Kas Terkumpul (Rp)',
              data: valuesMinggu,
              backgroundColor: '#10b981',
              borderRadius: 8
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: { display: false }
            },
            scales: {
              y: {
                beginAtZero: true,
                ticks: {
                  callback: val => 'Rp ' + (val / 1000) + 'k'
                }
              }
            }
          }
        });
      }

      // 2. Chart 6 Bulan Terakhir
      const ctxBulanan = document.getElementById('chartBulanan')?.getContext('2d');
      if (ctxBulanan) {
        if (chartBulananInstance) chartBulananInstance.destroy();

        const blnIndices = [5, 6, 7, 8, 9, 10]; // Mei - Okt
        const labelsBln = ['Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt'];
        const valuesBln = blnIndices.map(b => {
          return transaksiList
            .filter(x => x.tahun === 2026 && x.bulan === b)
            .reduce((acc, c) => acc + Number(c.nominal), 0);
        });

        chartBulananInstance = new Chart(ctxBulanan, {
          type: 'line',
          data: {
            labels: labelsBln,
            datasets: [{
              label: 'Penerimaan Kas (Rp)',
              data: valuesBln,
              borderColor: '#0d9488',
              backgroundColor: 'rgba(13, 148, 136, 0.1)',
              tension: 0.35,
              fill: true,
              pointBackgroundColor: '#0d9488',
              pointRadius: 4
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: { display: false }
            },
            scales: {
              y: {
                beginAtZero: true,
                ticks: {
                  callback: val => 'Rp ' + (val / 1000) + 'k'
                }
              }
            }
          }
        });
      }
    }

    // --- 13. BOOTSTRAP PADA SAAT LOAD ---
    window.addEventListener('DOMContentLoaded', () => {
      initDatabase();

      // Set tanggal aktif di header
      const now = new Date();
      const options = { weekday: 'long', year: 'numeric', month: 'short', day: 'numeric' };
      document.getElementById('currentDateDisplay').innerText = now.toLocaleDateString('id-ID', options);

      // Isi setting form
      document.getElementById('settingDefaultNominal').value = appSettings.defaultNominal;
      document.getElementById('settingNamaPetugas').value = appSettings.namaPetugas;

      // Render awal
      renderPenarikan();
      renderWargaTable();
      renderPengeluaranTable();
      renderLaporan();
      renderDashboardCharts();
      updateGlobalMetrics();
    });
  </script>
</body>
