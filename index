    // --- 6. PENARIKAN JIMPITAN (MODE LAPANGAN) ---
    function renderPenarikan() {
      const t = parseInt(document.getElementById('penarikanTahun').value);
      const b = parseInt(document.getElementById('penarikanBulan').value);
      const m = parseInt(document.getElementById('penarikanMinggu').value);
      const filter = document.getElementById('penarikanFilterStatus').value;
      const cari = document.getElementById('penarikanCari').value.toLowerCase().trim();

      const container = document.getElementById('penarikanCardList');
      container.innerHTML = '';

      let subtotal = 0;
      let totalLunas = 0;

      // Filter daftar warga
      const filteredWarga = wargaList.filter(w => {
        const matchCari = w.nama.toLowerCase().includes(cari) || w.blokNo.toLowerCase().includes(cari);
        const trx = transaksiList.find(x => x.wargaId === w.id && x.tahun === t && x.bulan === b && x.minggu === m);
        const sudahSetor = !!trx;

        if (!matchCari) return false;
        if (filter === 'sudah' && !sudahSetor) return false;
        if (filter === 'belum' && sudahSetor) return false;
        return true;
      });

      // Sort warga berdasarkan blok
      filteredWarga.sort((a, b) => a.blokNo.localeCompare(b.blokNo, undefined, { numeric: true }));

      filteredWarga.forEach(w => {
        const trx = transaksiList.find(x => x.wargaId === w.id && x.tahun === t && x.bulan === b && x.minggu === m);
        const isSetor = !!trx;

        if (isSetor) {
          subtotal += Number(trx.nominal);
          totalLunas++;
        }

        const card = document.createElement('div');
        card.className = `p-3.5 rounded-2xl border transition-all duration-200 ${
          isSetor 
            ? 'bg-emerald-50/70 border-emerald-300 shadow-sm' 
            : 'bg-white border-slate-200 hover:border-slate-300 shadow-sm'
        } flex items-center justify-between gap-3`;

        const waText = encodeURIComponent(
