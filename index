      localStorage.setItem(STORAGE_KEY_PENGELUARAN, JSON.stringify(pengeluaranList));
      localStorage.setItem(STORAGE_KEY_SETTINGS, JSON.stringify(appSettings));
      updateGlobalMetrics();
    }

    function resetDataBawaan() {
      Swal.fire({
        title: 'Reset ke Data Bawaan?',
        text: 'Seluruh riwayat transaksi saat ini akan dikembalikan ke data awal!',
