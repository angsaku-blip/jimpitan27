    function bukaModalWarga(edit = false) {
      document.getElementById('modalWargaTitle').innerText = edit ? 'Ubah Data Warga' : 'Tambah Data Warga RT 27';
      if (!edit) {
        document.getElementById('formWarga').reset();
        document.getElementById('wargaId').value = '';
      }
      document.getElementById('modalWarga').classList.remove('hidden');
    }

    function tutupModalWarga() {
      document.getElementById('modalWarga').classList.add('hidden');
    }

    function simpanDataWarga(e) {
      e.preventDefault();
      const id = document.getElementById('wargaId').value;
      const blokNo = document.getElementById('wargaBlokNo').value.trim().toUpperCase();
      const nama = document.getElementById('wargaNama').value.trim();
      const status = document.getElementById('wargaStatus').value;
      let wa = document.getElementById('wargaWa').value.trim().replace(/[^0-9]/g, '');

      if (wa.startsWith('0')) wa = '62' + wa.substring(1);

      // Cek duplikasi nomor blok
      const duplicate = wargaList.find(w => w.blokNo.toLowerCase() === blokNo.toLowerCase() && w.id !== id);
      if (duplicate) {
        Swal.fire('Perhatian', `Rumah Blok ${blokNo} sudah terdaftar atas nama ${duplicate.nama}`, 'warning');
        return;
      }

      if (id) {
        // Update
        const idx = wargaList.findIndex(w => w.id === id);
        if (idx !== -1) {
          wargaList[idx] = { id, blokNo, nama, status, wa };
        }
      } else {
        // Create
        wargaList.push({
          id: 'W-' + Date.now(),
          blokNo,
          nama,
          status,
          wa
        });
      }

      saveAll();
      tutupModalWarga();
      renderWargaTable();
      renderPenarikan();
      Swal.fire({ icon: 'success', title: 'Data Warga Tersimpan', showConfirmButton: false, timer: 1200 });
    }

    function editWarga(id) {
      const w = wargaList.find(x => x.id === id);
      if (!w) return;
      document.getElementById('wargaId').value = w.id;
      document.getElementById('wargaBlokNo').value = w.blokNo;
      document.getElementById('wargaNama').value = w.nama;
      document.getElementById('wargaStatus').value = w.status;
      document.getElementById('wargaWa').value = w.wa || '';
      bukaModalWarga(true);
    }

    function hapusWarga(id) {
      Swal.fire({
        title: 'Hapus Warga Ini?',
        text: 'Seluruh riwayat penarikan jimpitan untuk rumah ini juga akan dibersihkan.',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        cancelButtonColor: '#94a3b8',
        confirmButtonText: 'Ya, Hapus'
      }).then((result) => {
        if (result.isConfirmed) {
          wargaList = wargaList.filter(x => x.id !== id);
          transaksiList = transaksiList.filter(x => x.wargaId !== id);
          saveAll();
          renderWargaTable();
          renderPenarikan();
          Swal.fire('Dihapus', 'Data warga berhasil dihapus', 'success');
        }
      });
    }

