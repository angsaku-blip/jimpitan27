        const mBtn = document.getElementById(`mtab-${v}`);
        if (mBtn) {
          mBtn.classList.remove('text-emerald-700', 'font-bold');
          mBtn.classList.add('text-slate-400');
        }
      });

      // Active tab
      document.getElementById(`view-${tabId}`).classList.remove('hidden');

      const activeD = document.getElementById(`dtab-${tabId}`);
      if (activeD) {
        activeD.classList.add('border-emerald-600', 'text-emerald-700');
        activeD.classList.remove('border-transparent', 'text-slate-500');
      }

      const activeM = document.getElementById(`mtab-${tabId}`);
      if (activeM) {
        activeM.classList.add('text-emerald-700', 'font-bold');
        activeM.classList.remove('text-slate-400');
      }

