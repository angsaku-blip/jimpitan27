    // --- 9. LAPORAN & REKAPITULASI ENGINE ---
    function setLaporanMode(mode) {
      currentLaporanMode = mode;
      ['mingguan', 'bulanan', 'tahunan'].forEach(m => {
        const btn = document.getElementById(`subtab-${m}`);
        if (m === mode) {
          btn.className = 'flex-1 py-1.5 text-xs font-bold rounded-lg bg-white shadow-sm text-emerald-800';
        } else {
          btn.className = 'flex-1 py-1.5 text-xs font-bold rounded-lg text-slate-600 hover:text-slate-900';
        }
      });

      document.getElementById('wrapperLapBulan').style.display = mode === 'tahunan' ? 'none' : 'block';
      document.getElementById('wrapperLapMinggu').style.display = mode === 'mingguan' ? 'block' : 'none';

      renderLaporan();
    }

