      return arr[b] || '';
    }

    // --- 5. UI CONTROLLER (TAB SWITCH) ---
    function switchTab(tabId) {
      const views = ['dashboard', 'penarikan', 'warga', 'pengeluaran', 'laporan', 'pengaturan'];
      views.forEach(v => {
        document.getElementById(`view-${v}`).classList.add('hidden');

