      if (tabId === 'dashboard') {
        renderDashboardCharts();
      } else if (tabId === 'penarikan') {
        renderPenarikan();
      } else if (tabId === 'warga') {
        renderWargaTable();
      } else if (tabId === 'pengeluaran') {
