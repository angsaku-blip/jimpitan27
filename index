    // --- 3. INIT & LOCAL STORAGE ---
    function initDatabase() {
      const storedWarga = localStorage.getItem(STORAGE_KEY_WARGA);
      const storedTrx = localStorage.getItem(STORAGE_KEY_TRANSAKSI);
      const storedExp = localStorage.getItem(STORAGE_KEY_PENGELUARAN);
      const storedSet = localStorage.getItem(STORAGE_KEY_SETTINGS);

