<body class="bg-slate-50 text-slate-800 pb-24 md:pb-8 flex flex-col min-h-screen">

  <!-- HEADER -->
  <header class="bg-gradient-to-r from-emerald-700 via-teal-700 to-emerald-800 text-white shadow-md sticky top-0 z-40">
    <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-xl bg-white/10 backdrop-blur-sm border border-white/20 flex items-center justify-center text-emerald-300 text-xl font-extrabold shadow-inner">
          <i class="fa-solid fa-hand-holding-dollar"></i>
        </div>
        <div>
          <h1 class="text-base md:text-lg font-bold leading-tight flex items-center gap-1.5">
            SI-JIMPITAN 27
            <span class="text-[10px] bg-emerald-500/40 text-emerald-100 px-1.5 py-0.5 rounded border border-emerald-400/30">RT 27</span>
          </h1>
          <p class="text-xs text-emerald-100/80">RW 08 Griya Kebonagung, Sukodono</p>
        </div>
      </div>
      <div class="text-right">
        <span class="text-[11px] block text-emerald-200" id="currentDateDisplay">Senin, 20 Okt 2026</span>
        <span class="text-xs font-semibold bg-emerald-900/60 text-emerald-300 px-2.5 py-0.5 rounded-full border border-emerald-500/30 inline-block mt-0.5" id="navSaldoBadge">Kas: Rp 0</span>
      </div>
    </div>
  </header>

  <!-- DESKTOP TOP NAV BAR -->
  <nav class="hidden md:block bg-white border-b border-slate-200 shadow-sm sticky top-[61px] z-30">
    <div class="max-w-6xl mx-auto px-4 flex space-x-2">
      <button onclick="switchTab('dashboard')" id="dtab-dashboard" class="tab-btn px-4 py-3 font-semibold text-sm border-b-2 border-emerald-600 text-emerald-700 flex items-center gap-2">
        <i class="fa-solid fa-chart-pie"></i> Dashboard
      </button>
      <button onclick="switchTab('penarikan')" id="dtab-penarikan" class="tab-btn px-4 py-3 font-semibold text-sm border-b-2 border-transparent text-slate-500 hover:text-emerald-600 flex items-center gap-2">
        <i class="fa-solid fa-coins"></i> Input Jimpitan
      </button>
      <button onclick="switchTab('warga')" id="dtab-warga" class="tab-btn px-4 py-3 font-semibold text-sm border-b-2 border-transparent text-slate-500 hover:text-emerald-600 flex items-center gap-2">
        <i class="fa-solid fa-users"></i> Data Warga
      </button>
      <button onclick="switchTab('pengeluaran')" id="dtab-pengeluaran" class="tab-btn px-4 py-3 font-semibold text-sm border-b-2 border-transparent text-slate-500 hover:text-emerald-600 flex items-center gap-2">
        <i class="fa-solid fa-receipt"></i> Kas & Biaya
      </button>
      <button onclick="switchTab('laporan')" id="dtab-laporan" class="tab-btn px-4 py-3 font-semibold text-sm border-b-2 border-transparent text-slate-500 hover:text-emerald-600 flex items-center gap-2">
        <i class="fa-solid fa-file-invoice-dollar"></i> Laporan & Rekap
      </button>
      <button onclick="switchTab('pengaturan')" id="dtab-pengaturan" class="tab-btn px-4 py-3 font-semibold text-sm border-b-2 border-transparent text-slate-500 hover:text-emerald-600 flex items-center gap-2">
        <i class="fa-solid fa-sliders"></i> Pengaturan
      </button>
    </div>
  </nav>

  <!-- MAIN CONTAINER -->
  <main class="flex-grow max-w-6xl w-full mx-auto p-3 md:p-6 space-y-6">

    <!-- TAB 1: DASHBOARD RINGKASAN -->
    <section id="view-dashboard" class="space-y-5">
      <!-- Metrik Statistik -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4">
        <div class="bg-white p-4 rounded-2xl border border-slate-200/80 shadow-sm relative overflow-hidden">
          <div class="absolute -right-3 -bottom-3 text-emerald-100 text-6xl opacity-40"><i class="fa-solid fa-wallet"></i></div>
          <p class="text-xs font-semibold uppercase text-slate-500 tracking-wider">Saldo Bersih</p>
          <h2 class="text-lg md:text-2xl font-black text-emerald-700 mt-1" id="dashTotalSaldo">Rp 0</h2>
          <span class="text-[11px] text-slate-400 mt-1 block">Akumulasi Kas Tersedia</span>
        </div>

        <div class="bg-white p-4 rounded-2xl border border-slate-200/80 shadow-sm relative overflow-hidden">
          <div class="absolute -right-3 -bottom-3 text-teal-100 text-6xl opacity-40"><i class="fa-solid fa-hand-holding-hand"></i></div>
          <p class="text-xs font-semibold uppercase text-slate-500 tracking-wider">Pekan Ini</p>
          <h2 class="text-lg md:text-2xl font-black text-teal-600 mt-1" id="dashTotalPekanIni">Rp 0</h2>
          <span class="text-[11px] text-slate-400 mt-1 block" id="dashLabelPekanIni">Minggu aktif</span>
        </div>

        <div class="bg-white p-4 rounded-2xl border border-slate-200/80 shadow-sm relative overflow-hidden">
          <div class="absolute -right-3 -bottom-3 text-rose-100 text-6xl opacity-40"><i class="fa-solid fa-arrow-trend-down"></i></div>
          <p class="text-xs font-semibold uppercase text-slate-500 tracking-wider">Pengeluaran</p>
          <h2 class="text-lg md:text-2xl font-black text-rose-600 mt-1" id="dashTotalPengeluaran">Rp 0</h2>
          <span class="text-[11px] text-slate-400 mt-1 block">Total dana terpakai</span>
        </div>

        <div class="bg-white p-4 rounded-2xl border border-slate-200/80 shadow-sm relative overflow-hidden">
          <div class="absolute -right-3 -bottom-3 text-blue-100 text-6xl opacity-40"><i class="fa-solid fa-circle-check"></i></div>
          <p class="text-xs font-semibold uppercase text-slate-500 tracking-wider">Partisipasi</p>
          <h2 class="text-lg md:text-2xl font-black text-blue-600 mt-1" id="dashPartisipasi">0%</h2>
          <span class="text-[11px] text-slate-400 mt-1 block" id="dashPartisipasiDetail">0 dari 0 Rumah</span>
        </div>
      </div>

      <!-- Quick Action Mobile Button -->
      <div class="bg-gradient-to-r from-emerald-600 to-teal-700 rounded-2xl p-4 text-white shadow-md flex items-center justify-between">
        <div>
          <h3 class="font-bold text-sm md:text-base">Mulai Keliling Jimpitan?</h3>
          <p class="text-xs text-emerald-100">Buka mode satu-klik untuk input cepat ke tiap rumah.</p>
        </div>
        <button onclick="switchTab('penarikan')" class="px-4 py-2 bg-white text-emerald-800 font-bold text-xs md:text-sm rounded-xl shadow hover:bg-emerald-50 active:scale-95 transition-all">
          <i class="fa-solid fa-bolt mr-1"></i> Mode Cepat
        </button>
      </div>

      <!-- Grafik & Tren -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="bg-white p-4 md:p-5 rounded-2xl border border-slate-200/80 shadow-sm">
          <div class="flex items-center justify-between mb-3">
            <h4 class="font-bold text-sm text-slate-700"><i class="fa-solid fa-chart-column text-emerald-600 mr-1.5"></i> Perolehan 4 Pekan Terakhir</h4>
          </div>
          <div class="h-56">
            <canvas id="chartMingguan"></canvas>
          </div>
        </div>

        <div class="bg-white p-4 md:p-5 rounded-2xl border border-slate-200/80 shadow-sm">
          <div class="flex items-center justify-between mb-3">
            <h4 class="font-bold text-sm text-slate-700"><i class="fa-solid fa-chart-line text-teal-600 mr-1.5"></i> Tren Kas 6 Bulan Terakhir</h4>
          </div>
          <div class="h-56">
            <canvas id="chartBulanan"></canvas>
          </div>
        </div>
      </div>
    </section>

    <!-- TAB 2: PENARIKAN MINGGUAN (MODE CEPAT) -->
    <section id="view-penarikan" class="hidden space-y-4">
      <!-- Periode & Filter Controls -->
      <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm space-y-3">
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
          <div>
            <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1">Tahun</label>
            <select id="penarikanTahun" onchange="renderPenarikan()" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-sm font-semibold text-slate-700 focus:ring-2 focus:ring-emerald-500 focus:outline-none">
              <option value="2026" selected>2026</option>
              <option value="2025">2025</option>
            </select>
          </div>

          <div>
            <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1">Bulan</label>
            <select id="penarikanBulan" onchange="renderPenarikan()" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-sm font-semibold text-slate-700 focus:ring-2 focus:ring-emerald-500 focus:outline-none">
              <option value="1">Januari</option>
              <option value="2">Februari</option>
              <option value="3">Maret</option>
              <option value="4">April</option>
              <option value="5">Mei</option>
              <option value="6">Juni</option>
              <option value="7">Juli</option>
              <option value="8">Agustus</option>
              <option value="9">September</option>
              <option value="10" selected>Oktober</option>
              <option value="11">November</option>
              <option value="12">Desember</option>
            </select>
          </div>

          <div>
            <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1">Minggu Ke-</label>
            <select id="penarikanMinggu" onchange="renderPenarikan()" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-sm font-semibold text-slate-700 focus:ring-2 focus:ring-emerald-500 focus:outline-none">
              <option value="1">Minggu 1</option>
              <option value="2">Minggu 2</option>
              <option value="3" selected>Minggu 3</option>
              <option value="4">Minggu 4</option>
              <option value="5">Minggu 5</option>
            </select>
          </div>

          <div>
            <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1">Filter Status</label>
            <select id="penarikanFilterStatus" onchange="renderPenarikan()" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-sm font-semibold text-slate-700 focus:ring-2 focus:ring-emerald-500 focus:outline-none">
              <option value="all">Semua Rumah</option>
              <option value="belum">Belum Setor</option>
              <option value="sudah">Sudah Setor</option>
            </select>
          </div>
        </div>

        <!-- Search Bar -->
        <div class="relative">
          <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-3 text-slate-400 text-sm"></i>
          <input type="text" id="penarikanCari" oninput="renderPenarikan()" placeholder="Cari nomor rumah (mis: A1/05) atau nama warga..." class="w-full bg-slate-50 border border-slate-300 rounded-xl pl-10 pr-4 py-2 text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none">
        </div>

        <!-- Ringkasan Cepat Periode Ini -->
        <div class="flex items-center justify-between text-xs font-medium pt-1 text-slate-600 border-t border-slate-100">
          <span>Target Terkumpul: <strong class="text-emerald-700" id="penarikanSubtotal">Rp 0</strong></span>
          <span id="penarikanHitungRumah">0 / 0 Rumah</span>
        </div>
      </div>

      <!-- List Warga (Card Grid) -->
      <div id="penarikanCardList" class="grid grid-cols-1 md:grid-cols-2 gap-2.5">
        <!-- Rendered via JS -->
      </div>
    </section>

    <!-- TAB 3: DATA WARGA RT 27 -->
    <section id="view-warga" class="hidden space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-white p-4 rounded-2xl border border-slate-200">
        <div>
          <h3 class="font-bold text-slate-800 text-base">Daftar Warga RT 27</h3>
          <p class="text-xs text-slate-500">Master data nomor rumah & nomor WhatsApp penanggung jawab.</p>
        </div>
        <div class="flex gap-2">
          <button onclick="bukaModalWarga()" class="px-3.5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-semibold flex items-center gap-1.5 shadow-sm active:scale-95 transition-all">
            <i class="fa-solid fa-user-plus"></i> Tambah Warga
          </button>
        </div>
      </div>

      <!-- Quick Search Warga -->
      <div class="bg-white p-3 rounded-2xl border border-slate-200">
        <input type="text" id="wargaCari" oninput="renderWargaTable()" placeholder="Cari nama atau blok rumah..." class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none">
      </div>

      <!-- Table Warga -->
      <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs md:text-sm">
            <thead class="bg-slate-100 text-slate-600 font-bold border-b border-slate-200">
              <tr>
                <th class="p-3 w-14 text-center">No</th>
                <th class="p-3">Blok / No</th>
                <th class="p-3">Kepala Keluarga</th>
                <th class="p-3">Status</th>
                <th class="p-3">WhatsApp</th>
                <th class="p-3 text-center">Aksi</th>
              </tr>
            </thead>
            <tbody id="wargaTableBody" class="divide-y divide-slate-100">
              <!-- Rendered via JS -->
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- TAB 4: KAS & PENGELUARAN -->
    <section id="view-pengeluaran" class="hidden space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-white p-4 rounded-2xl border border-slate-200">
        <div>
          <h3 class="font-bold text-slate-800 text-base">Buku Kas Keluar RT 27</h3>
          <p class="text-xs text-slate-500">Pencatatan alokasi dana jimpitan untuk kegiatan lingkungan.</p>
        </div>
        <button onclick="bukaModalPengeluaran()" class="px-3.5 py-2 bg-rose-600 hover:bg-rose-700 text-white rounded-xl text-xs font-semibold flex items-center gap-1.5 shadow-sm active:scale-95 transition-all">
          <i class="fa-solid fa-plus-minus"></i> Catat Pengeluaran
        </button>
      </div>

      <!-- Table Pengeluaran -->
      <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs md:text-sm">
            <thead class="bg-slate-100 text-slate-600 font-bold border-b border-slate-200">
              <tr>
                <th class="p-3">Tanggal</th>
                <th class="p-3">Keperluan / Deskripsi</th>
                <th class="p-3">Kategori</th>
                <th class="p-3 text-right">Nominal</th>
                <th class="p-3 text-center">Aksi</th>
              </tr>
            </thead>
            <tbody id="pengeluaranTableBody" class="divide-y divide-slate-100">
              <!-- Rendered via JS -->
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- TAB 5: LAPORAN & REKAPITULASI -->
    <section id="view-laporan" class="hidden space-y-4">
      <div class="bg-white p-4 rounded-2xl border border-slate-200 space-y-3">
        <!-- Sub-tab Switcher -->
        <div class="flex p-1 bg-slate-100 rounded-xl gap-1">
          <button onclick="setLaporanMode('mingguan')" id="subtab-mingguan" class="flex-1 py-1.5 text-xs font-bold rounded-lg bg-white shadow-sm text-emerald-800">Mingguan</button>
          <button onclick="setLaporanMode('bulanan')" id="subtab-bulanan" class="flex-1 py-1.5 text-xs font-bold rounded-lg text-slate-600 hover:text-slate-900">Bulanan</button>
          <button onclick="setLaporanMode('tahunan')" id="subtab-tahunan" class="flex-1 py-1.5 text-xs font-bold rounded-lg text-slate-600 hover:text-slate-900">Matriks 12 Bulan</button>
        </div>

        <!-- Filter Laporan -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 pt-1">
          <div>
            <label class="block text-[11px] font-bold text-slate-500 mb-1">Tahun</label>
            <select id="lapTahun" onchange="renderLaporan()" class="w-full bg-slate-50 border border-slate-300 rounded-lg px-2.5 py-1.5 text-xs font-medium">
              <option value="2026" selected>2026</option>
              <option value="2025">2025</option>
            </select>
          </div>
          <div id="wrapperLapBulan">
            <label class="block text-[11px] font-bold text-slate-500 mb-1">Bulan</label>
            <select id="lapBulan" onchange="renderLaporan()" class="w-full bg-slate-50 border border-slate-300 rounded-lg px-2.5 py-1.5 text-xs font-medium">
              <option value="1">Januari</option>
              <option value="2">Februari</option>
              <option value="3">Maret</option>
              <option value="4">April</option>
              <option value="5">Mei</option>
              <option value="6">Juni</option>
              <option value="7">Juli</option>
              <option value="8">Agustus</option>
              <option value="9">September</option>
              <option value="10" selected>Oktober</option>
              <option value="11">November</option>
              <option value="12">Desember</option>
            </select>
          </div>
          <div id="wrapperLapMinggu">
            <label class="block text-[11px] font-bold text-slate-500 mb-1">Minggu</label>
            <select id="lapMinggu" onchange="renderLaporan()" class="w-full bg-slate-50 border border-slate-300 rounded-lg px-2.5 py-1.5 text-xs font-medium">
              <option value="1">Minggu 1</option>
              <option value="2">Minggu 2</option>
              <option value="3" selected>Minggu 3</option>
              <option value="4">Minggu 4</option>
              <option value="5">Minggu 5</option>
            </select>
          </div>
          <div class="flex items-end gap-1.5 col-span-2 sm:col-span-1">
            <button onclick="eksporExcel()" class="flex-1 bg-emerald-700 hover:bg-emerald-800 text-white rounded-lg py-1.5 text-xs font-semibold flex items-center justify-center gap-1 shadow-sm">
              <i class="fa-solid fa-file-excel"></i> Excel
            </button>
            <button onclick="eksporPDF()" class="flex-1 bg-rose-700 hover:bg-rose-800 text-white rounded-lg py-1.5 text-xs font-semibold flex items-center justify-center gap-1 shadow-sm">
              <i class="fa-solid fa-file-pdf"></i> PDF
            </button>
          </div>
        </div>
      </div>

      <!-- Preview Laporan Render -->
      <div id="laporanContainer" class="bg-white rounded-2xl border border-slate-200 p-4 shadow-sm overflow-x-auto">
        <!-- Rendered via JS -->
      </div>
    </section>

    <!-- TAB 6: PENGATURAN & BACKUP -->
    <section id="view-pengaturan" class="hidden space-y-4">
      <div class="bg-white p-5 rounded-2xl border border-slate-200 space-y-4">
        <h3 class="font-bold text-base text-slate-800 flex items-center gap-2">
          <i class="fa-solid fa-gear text-emerald-600"></i> Pengaturan Aplikasi
        </h3>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-slate-600 mb-1">Nominal Jimpitan Standar (Rp)</label>
            <input type="number" id="settingDefaultNominal" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-sm font-semibold focus:ring-2 focus:ring-emerald-500" value="2000">
            <span class="text-[11px] text-slate-400">Nominal dasar untuk tombol "Bayar Cepat"</span>
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-600 mb-1">Nama Petugas Penarik Default</label>
            <input type="text" id="settingNamaPetugas" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-sm font-semibold focus:ring-2 focus:ring-emerald-500" value="Bpk. Wawan (Koord Jimpitan)">
            <span class="text-[11px] text-slate-400">Dicetak di kuitansi dan rekap laporan</span>
          </div>
        </div>

        <button onclick="simpanPengaturan()" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold shadow">
          Simpan Preferensi
        </button>
      </div>

      <!-- Backup and Reset Data -->
      <div class="bg-white p-5 rounded-2xl border border-slate-200 space-y-3">
        <h3 class="font-bold text-base text-slate-800 flex items-center gap-2">
          <i class="fa-solid fa-database text-teal-600"></i> Cadangkan & Pulihkan Data
        </h3>
