    function setorCepat(wargaId, nominal) {
      const t = parseInt(document.getElementById('penarikanTahun').value);
      const b = parseInt(document.getElementById('penarikanBulan').value);
      const m = parseInt(document.getElementById('penarikanMinggu').value);

      const newTrx = {
        id: 'TRX-' + Date.now(),
        wargaId: wargaId,
        tahun: t,
        bulan: b,
        minggu: m,
        nominal: Number(nominal),
        tanggal: new Date().toISOString().split('T')[0],
        petugas: appSettings.namaPetugas
      };

      transaksiList.push(newTrx);
      saveAll();
      renderPenarikan();
    }

    function setorCustom(wargaId, nama, blok) {
      const t = parseInt(document.getElementById('penarikanTahun').value);
      const b = parseInt(document.getElementById('penarikanBulan').value);
      const m = parseInt(document.getElementById('penarikanMinggu').value);

      Swal.fire({
        title: `Setor Jimpitan`,
        html: `<strong>${blok}</strong> - ${nama}<br><span class="text-xs text-slate-500">Minggu ${m} ${namaBulan(b)} ${t}</span>`,
        input: 'number',
        inputValue: appSettings.defaultNominal,
        inputAttributes: {
          min: '500',
          step: '500'
        },
        showCancelButton: true,
        confirmButtonColor: '#059669',
        cancelButtonColor: '#94a3b8',
        confirmButtonText: 'Simpan Pembayaran',
        cancelButtonText: 'Batal',
        inputValidator: (value) => {
          if (!value || parseInt(value) < 500) {
            return 'Masukkan nominal valid minimal Rp 500!';
          }
        }
      }).then((result) => {
        if (result.isConfirmed) {
          setorCepat(wargaId, parseInt(result.value));
        }
      });
    }

    function batalSetor(trxId) {
      Swal.fire({
        title: 'Batalkan Pembayaran?',
        text: 'Status rumah akan dikembalikan menjadi belum setor.',
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        cancelButtonColor: '#94a3b8',
        confirmButtonText: 'Ya, Batalkan'
      }).then((result) => {
        if (result.isConfirmed) {
          transaksiList = transaksiList.filter(x => x.id !== trxId);
          saveAll();
          renderPenarikan();
        }
      });
    }

    // --- 7. MASTER DATA WARGA ---
