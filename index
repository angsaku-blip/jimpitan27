          renderPenarikan();
          renderWargaTable();
          renderPengeluaranTable();
          renderLaporan();
          renderDashboardCharts();
          Swal.fire('Berhasil', 'Data kembali ke pengaturan awal contoh RT 27', 'success');
        }
      });
    }

    // --- 4. FORMATTERS ---
    const formatRupiah = (number) => {
      return new Intl.NumberFormat('id-ID', {
        style: 'currency',
        currency: 'IDR',
        minimumFractionDigits: 0
      }).format(number);
    };

    function updateGlobalMetrics() {
      const totalMasuk = transaksiList.reduce((acc, curr) => acc + Number(curr.nominal), 0);
      const totalKeluar = pengeluaranList.reduce((acc, curr) => acc + Number(curr.nominal), 0);
      const saldoBersih = totalMasuk - totalKeluar;

      document.getElementById('navSaldoBadge').innerText = `Kas: ${formatRupiah(saldoBersih)}`;
      document.getElementById('dashTotalSaldo').innerText = formatRupiah(saldoBersih);
      document.getElementById('dashTotalPengeluaran').innerText = formatRupiah(totalKeluar);

      // Hitung metrik periode aktif penarikan
      const t = parseInt(document.getElementById('penarikanTahun')?.value || '2026');
      const b = parseInt(document.getElementById('penarikanBulan')?.value || '10');
      const m = parseInt(document.getElementById('penarikanMinggu')?.value || '3');

      const trxPekanIni = transaksiList.filter(x => x.tahun === t && x.bulan === b && x.minggu === m);
      const subtotalPekanIni = trxPekanIni.reduce((acc, c) => acc + Number(c.nominal), 0);

